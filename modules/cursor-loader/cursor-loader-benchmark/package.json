{
  "name": "@cobol-ts/cursor-loader-benchmark",
  "description": "TypeScript end-to-end COBOL cursor benchmark against JRecord with deterministic 200-byte fixtures",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index",
  "types": "dist/index",
  "dependencies": {
    "@cobol-ts/arrays": "0.0.1",
    "@cobol-ts/codec": "0.0.1",
    "@cobol-ts/cursor-loader-cobol": "0.0.1",
    "@cobol-ts/cursor-loader-types": "0.0.1",
    "@cobol-ts/cursor-projection": "0.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@types/jest": "^29.0.0",
    "@types/node": "^14.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/",
    "build/",
    "copybooks/",
    "data/sample-100k.dat"
  ],
  "license": "MIT",
  "repository": "git@github.com:intellimaintain/intellimaintain.git",
  "scripts": {
    "test": "jest --config jest.config.json --env node",
    "test:watch": "npm run test -- --watch",
    "build": "tsc",
    "generate": "ts-node --transpile-only src/benchmark.generate.cli.ts",
    "generate:sample": "ts-node --transpile-only src/benchmark.generate.cli.ts --records 100000 --output data/sample-100k.dat --force",
    "verify": "ts-node --transpile-only src/benchmark.verify.cli.ts",
    "benchmark": "ts-node --transpile-only --prefer-ts-exts src/benchmark.cli.ts",
    "benchmark:sample": "ts-node --transpile-only --prefer-ts-exts src/benchmark.cli.ts --sample",
    "benchmark:callback": "ts-node --transpile-only --prefer-ts-exts src/benchmark.callback.cli.ts",
    "benchmark:callback:sample": "ts-node --transpile-only --prefer-ts-exts src/benchmark.callback.cli.ts --sample"
  }
}
