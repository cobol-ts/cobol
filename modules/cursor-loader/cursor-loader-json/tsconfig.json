{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": [
      "ES2022",
      "DOM"
    ],

    "types": [
      "jest"
    ],
    "strictNullChecks": true,
    "outDir": "./dist",
    "declaration": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true
  },

  "include": [
    "src/**/*.ts",
    "index.ts"
  ],

  "exclude": [
    "dist/**/*.ts",
    "node_modules"
  ]
}